.aircraft-seats {
    width: 520px;
    margin: 20px auto;
    padding: 35px 20px;
    background: #eeeeee;
    border-radius: 120px 120px 40px 40px;
    border: 2px solid #cccccc;
    transform: rotate(-90deg);
}

.aircraft-seats .seat {
    transform: rotate(90deg);
}

.seat-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
    margin-bottom: 8px;
}

.seat {
    width: 42px;
    height: 36px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: bold;
    padding: 0;
}

/* 30 seats or less */
.aircraft-seats.small-seats .seat {
    width: 48px;
    height: 40px;
    font-size: 11px;
}

.aircraft-seats.small-seats .aisle {
    width: 40px;
    height: 40px;
}

/* More than 150 seats */
.aircraft-seats.large-seats .seat {
    width: 34px;
    height: 30px;
    font-size: 9px;
}

.aircraft-seats.large-seats .aisle {
    width: 28px;
    height: 30px;
}

/* Available seat */
.available-seat {
    background: white;
    border: 2px solid #198754;
    color: #198754;
    cursor: pointer;
}

.available-seat:hover {
    background: #198754;
    color: white;
}

/* Booked seat */
.booked-seat {
    background: #dc3545;
    border: 2px solid #dc3545;
    color: white;
    cursor: not-allowed;
}

/* Aisle */
.aisle {
    width: 35px;
    height: 36px;
}

/* Selected seat */
.available-seat.btn-primary {
    background: #0d6efd;
    border-color: #0d6efd;
    color: white;
}
