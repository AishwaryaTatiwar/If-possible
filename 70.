<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Airline Management System</title>
    <link rel="stylesheet" href="~/Content/Sites.css" />
    <link rel="stylesheet" href="~/Content/_Layout.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var currentAction = ViewContext.RouteData.Values["action"] as string;
        var currentController = ViewContext.RouteData.Values["controller"] as string;
    }

    <nav class="navbar navbar-expand-lg navbar-dark shadow">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="bi bi-airplane-engines-fill me-2"></i>AirlineMS
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    @if (Session["Role"] != null && Session["Role"].ToString() == "Customer")
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Index" && currentController == "Home" ? "active" : "")" href="@Url.Action("Index", "Home")">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "SearchFlights" && currentController == "Home" ? "active" : "")" href="@Url.Action("SearchFlights", "Home")">
                                <i class="bi bi-search"></i> Search Flights
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Profile" && currentController == "User" ? "active" : "")" href="@Url.Action("Profile", "User")">
                                <i class="bi bi-person"></i> Profile
                            </a>
                        </li>
                    }

                    @if (Session["Role"] != null && Session["Role"].ToString() == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Dashboard" && currentController == "Admin" ? "active" : "")" href="@Url.Action("Dashboard", "Admin")">
                                <i class="bi bi-speedometer2"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "ManageFlights" && currentController == "Admin" ? "active" : "")" href="@Url.Action("ManageFlights", "Admin")">
                                <i class="bi bi-airplane"></i>Manage Schedules
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "ManageBooking" && currentController == "Admin" ? "active" : "")" href="@Url.Action("ManageBooking", "Admin")">
                                <i class="bi bi-journal-check"></i>Manage Bookings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "ManageUsers" && currentController == "Admin" ? "active" : "")" href="@Url.Action("ManageUsers", "Admin")">
                                <i class="bi bi-people"></i>Manage Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "ManagePassengers" && currentController == "Admin" ? "active" : "")" href="@Url.Action("ManagePassengers", "Admin")">
                                <i class="bi bi-people"></i>Manage Passengers
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (Session["Username"] == null)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Login" && currentController == "User" ? "active" : "")" href="@Url.Action("Login", "User")">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentAction == "Register" && currentController == "User" ? "active" : "")" href="@Url.Action("Register", "User")">
                                <i class="bi bi-person-plus"></i> Register
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-link">
                                <i class="bi bi-person-circle"></i>Welcome, @Session["Username"]
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning" href="@Url.Action("Logout", "User")">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5 mb-4">
        @RenderBody()
    </div>

    <footer>
        <div class="container">
            <p>&copy; @DateTime.Now.Year - Airline Management System</p>
        </div>
    </footer>

    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
