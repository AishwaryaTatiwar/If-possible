body {
    background-color: #f4f8fc;
    font-family: 'Segoe UI', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-top: 60px;
}

.navbar {
    background: linear-gradient(90deg, #0d6efd, #0b5ed7);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 60px;
    z-index: 1030;
}

.navbar-brand {
    font-size: 1.4rem;
    font-weight: bold;
}

.nav-link {
    color: white !important;
    font-weight: 500;
    transition: .3s;
}

.nav-link:hover {
    color: #fd5a4f !important;
}

.card {
    border: none;
    border-radius: 15px;
}

.form-control,
.form-select {
    border-radius: 10px;
}

.btn {
    border-radius: 10px;
}

footer {
    margin-top: auto;
    background: #0d6efd;
    color: white;
    text-align: center;
    padding: 18px;
}
