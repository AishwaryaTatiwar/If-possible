<div id="deleteBookingModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Booking</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <p>Are you sure you want to delete this cancelled booking?</p>
                <p class="text-danger">
                    This action cannot be undone.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">
                    Cancel
                </button>

                <form id="deleteBookingForm"
                      action="@Url.Action("DeleteBooking", "Admin")"
                      method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="deleteBookingId"
                           name="id" />

                    <button type="submit"
                            class="btn btn-danger">
                        Delete Booking
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
