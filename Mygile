    // Highlight selected seat
    document.querySelectorAll(".seat").forEach(function (btn) {
        if (btn.getAttribute("data-seat-id") == seatId) {
            btn.classList.remove("btn-outline-primary");
            btn.classList.add("btn-primary");
        }
    });

    updateSelectedSeats();
}
