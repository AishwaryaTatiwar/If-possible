                btn.classList.remove("btn-primary");
                btn.classList.add("btn-outline-primary");
            }
        });
    }

    // Assign new seat
    selectedSeats[currentPassenger] = {
        seatId: seatId,
        seatNumber: seatNumber,
        seatType: seatType
