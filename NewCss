.aircraft-seats {
    width: 520px;
    margin: 20px auto;
    padding: 35px 20px;
    background: #eeeeee;
    border-radius: 120px 120px 40px 40px;
    border: 2px solid #cccccc;
    transform: rotate(-90deg);
}

.aircraft-seats .seat {
    transform: rotate(90deg);
}

.seat-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 7px;
    margin-bottom: 8px;
}

.seat {
    width: 42px;
    height: 36px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: bold;
    padding: 0;
}

.available-seat {
    background: white;
    border: 2px solid #198754;
    color: #198754;
    cursor: pointer;
}

.available-seat:hover {
    background: #198754;
    color: white;
}

.booked-seat {
    background: #dc3545;
    border: 2px solid #dc3545;
    color: white;
    cursor: not-allowed;
}

.aisle {
    width: 35px;
    height: 36px;
}

.available-seat.btn-primary {
    background: #0d6efd;
    border-color: #0d6efd;
    color: white;
}

/* MORE THAN 150 SEATS */
.aircraft-seats.large-seats {
    max-height: 650px;
    overflow-y: auto;
}

/* 30 OR FEWER SEATS */
.aircraft-seats.small-seats {
    margin-top: 50px;
    margin-bottom: 50px;
    padding-top: 50px;
    padding-bottom: 50px;
}
