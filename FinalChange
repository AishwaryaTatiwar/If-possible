// 9. Create seat locks
int userId = Convert.ToInt32(Session["UserID"]);
DateTime now = DateTime.Now;
DateTime expiryTime = now.AddMinutes(7);

// Remove expired locks
var expiredLocks = db.SeatLocks
    .Where(x => x.FlightID == flightId &&
                x.LockExpiryTime <= now)
    .ToList();

if (expiredLocks.Any())
{
    db.SeatLocks.RemoveRange(expiredLocks);
    db.SaveChanges();
}

// Check whether selected seats are locked by another user
foreach (var selectedSeatId in seatMap.Values)
{
    var existingLock = db.SeatLocks
        .FirstOrDefault(x => x.FlightID == flightId &&
                             x.SeatID == selectedSeatId &&
                             x.LockExpiryTime > now);

    if (existingLock != null && existingLock.UserID != userId)
    {
        TempData["Message"] =
            "One or more selected seats are currently being booked by another user. Please select different seats.";

        return RedirectToAction("SeatSelection");
    }
}

// Remove previous locks of this user for this flight
var oldLocks = db.SeatLocks
    .Where(x => x.FlightID == flightId &&
                x.UserID == userId)
    .ToList();

if (oldLocks.Any())
{
    db.SeatLocks.RemoveRange(oldLocks);
}

// Create new locks
foreach (var selectedSeatId in seatMap.Values)
{
    SeatLock seatLock = new SeatLock
    {
        FlightID = flightId,
        SeatID = selectedSeatId,
        UserID = userId,
        LockTime = now,
        LockExpiryTime = expiryTime
    };

    db.SeatLocks.Add(seatLock);
}

db.SaveChanges();

// Store selected seats
Session[SESSION_SEAT_MAP] = seatMap;

// Store amount
Session[SESSION_FINAL_AMOUNT] = FinalAmount;

// Store lock expiry
Session["SeatLockExpiry"] = expiryTime;

return RedirectToAction("Payment");
