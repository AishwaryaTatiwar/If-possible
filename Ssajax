var seatId = this.getAttribute("data-seat-id");
var seatNumber = this.getAttribute("data-seat-number");
var seatType = this.getAttribute("data-seat-type");

var button = this;

var xhr = new XMLHttpRequest();
xhr.open("POST", "@Url.Action("LockSeat", "Booking")", true);
xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");

xhr.onreadystatechange = function () {
    if (xhr.readyState === 4) {
        if (xhr.status !== 200) {
            alert("Unable to lock the seat.");
            return;
        }

        var response = JSON.parse(xhr.responseText);

        if (!response.success) {
            alert(response.message);
            return;
        }

        // Seat successfully locked
        startSeatLockTimer(response.expiry);

        // Continue with your existing seat-selection logic
        selectSeatAfterLock(button, seatId, seatNumber, seatType);
    }
};

xhr.send("flightId=@ViewBag.FlightID&seatId=" + seatId);
